<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://entreprise.com/nsInvoice"
           xmlns:nsInvoice="http://entreprise.com/nsInvoice"
           xmlns:ds="http://www.w3.org/2000/09/xmldsig#"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified">

    <xs:element name="factureSignee">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="montantTTC" type="xs:decimal"/>
                <xs:any namespace="http://www.w3.org/2000/09/xmldsig#" processContents="lax" minOccurs="1" maxOccurs="unbounded"/>
            </xs:sequence>
            <xs:attribute name="idFacture" type="xs:string" use="required"/>
        </xs:complexType>
    </xs:element>
</xs:schema>
