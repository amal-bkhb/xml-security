<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://entreprise.com/nsPlateforme"
           xmlns:plateforme="http://entreprise.com/nsPlateforme"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified">

    <xs:element name="echanges">
        <xs:complexType>
            <xs:sequence>
                <xs:any namespace="http://entreprise.com/nsClient" processContents="lax" minOccurs="1" maxOccurs="unbounded"/>
                <xs:any namespace="http://entreprise.com/nsOrder" processContents="lax" minOccurs="1" maxOccurs="unbounded"/>
                <xs:any namespace="http://entreprise.com/nsInvoice" processContents="lax" minOccurs="1" maxOccurs="unbounded"/>
                <xs:any namespace="http://entreprise.com/nsSupport" processContents="lax" minOccurs="1" maxOccurs="unbounded"/>
            </xs:sequence>
            <xs:attribute name="dateGeneration" type="xs:date" use="required"/>
        </xs:complexType>
    </xs:element>
</xs:schema>
